# Copy to backend\.env and replace every CHANGE_ME. backend\.env is ignored by git: never
# commit it, and never put a real password in this example file.
#
# Every name starts with OAK_. The application refuses any database other than oak_binder
# and oak_binder_test, so nothing here can point at the Financial Spine's databases.

OAK_ENV=development

# The API connects as oak_binder_app: least privilege, no DDL, and no UPDATE or DELETE on
# the append-only tables. Host and port must be explicit.
OAK_DATABASE_URL=postgresql+psycopg://oak_binder_app:CHANGE_ME@localhost:5432/oak_binder

# Alembic migrations connect as oak_binder_owner.
OAK_MIGRATION_DATABASE_URL=postgresql+psycopg://oak_binder_owner:CHANGE_ME@localhost:5432/oak_binder

# Database tests: only the database oak_binder_test is accepted. Leave both unset to skip
# the tests marked "db". The owner URL migrates and inserts; the app URL proves that the
# application role cannot update or delete append-only rows.
# OAK_TEST_DATABASE_URL=postgresql+psycopg://oak_binder_owner:CHANGE_ME@localhost:5432/oak_binder_test
# OAK_TEST_APP_DATABASE_URL=postgresql+psycopg://oak_binder_app:CHANGE_ME@localhost:5432/oak_binder_test

# Recorded as preparer and reviewer until real authentication exists (architecture D8).
# The application refuses to start if this is set while OAK_ENV=production.
OAK_DEV_USER=dev@localhost

# Where attachment bytes live (architecture D7, D23). "local" is the write-once directory
# below; a relative path resolves from backend\. "vault" is reserved for the firm's document
# vault: it needs the three OAK_VAULT_* settings and an adapter, and no adapter exists until
# the vault is confirmed, so leave it at local.
OAK_STORE=local
OAK_ATTACHMENTS_DIR=../var/attachments
OAK_MAX_UPLOAD_BYTES=26214400
# OAK_VAULT_URL=CHANGE_ME
# OAK_VAULT_CREDENTIAL=CHANGE_ME
# OAK_VAULT_CONTAINER=CHANGE_ME
