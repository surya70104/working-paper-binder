# Copy to backend\.env and replace every CHANGE_ME. backend\.env is ignored by git: never
# commit it, and never put a real password in this example file.
#
# Every name starts with OAK_. The application refuses any database other than oak_binder
# and oak_binder_test, so nothing here can point at the Financial Spine's databases.

OAK_ENV=development

# The API connects as oak_binder_app: least privilege, no DDL, and no UPDATE or DELETE on
# the append-only tables. Host and port must be explicit.
OAK_DATABASE_URL=postgresql+psycopg://oak_binder_app:CHANGE_ME@localhost:5432/oak_binder

# Alembic migrations connect as oak_binder_owner.
OAK_MIGRATION_DATABASE_URL=postgresql+psycopg://oak_binder_owner:CHANGE_ME@localhost:5432/oak_binder

# Database tests: only the database oak_binder_test is accepted. Leave both unset to skip
# the tests marked "db". The owner URL migrates and inserts; the app URL proves that the
# application role cannot update or delete append-only rows.
# OAK_TEST_DATABASE_URL=postgresql+psycopg://oak_binder_owner:CHANGE_ME@localhost:5432/oak_binder_test
# OAK_TEST_APP_DATABASE_URL=postgresql+psycopg://oak_binder_app:CHANGE_ME@localhost:5432/oak_binder_test

# Who is acting (architecture D8, D24). OAK_AUTH=dev records OAK_DEV_USER as preparer,
# reviewer and signer; development and tests only, refused when OAK_ENV=production.
# OAK_AUTH=header takes the identity from the header an authenticating reverse proxy sets on
# every request; the Binder verifies nothing itself, so the proxy must be the only route in.
OAK_AUTH=dev
OAK_DEV_USER=dev@localhost
# OAK_AUTH_HEADER=X-Authenticated-User
# In header mode the header is believed only from these peer addresses (IPs or networks,
# comma-separated); required when OAK_ENV=production. Run uvicorn without --proxy-headers.
# OAK_TRUSTED_PROXIES=10.0.0.5, 10.0.1.0/24

# Where attachment bytes live (architecture D7, D23, D27). "local" is the write-once
# directory below; a relative path resolves from backend\. "vault" is the firm's Google Drive
# folder. Keep OAK_STORE=local until `python -m oak_binder.vault_login` has succeeded and
# `python -m oak_binder.vault_migrate --apply` has moved the existing attachments.
OAK_STORE=local
OAK_ATTACHMENTS_DIR=../var/attachments
OAK_MAX_UPLOAD_BYTES=26214400
# The Drive vault. The two files live under backend\secrets, which git ignores; their
# contents are never printed. The container is the vault folder's id from its Drive URL.
# OAK_VAULT_URL=https://www.googleapis.com/drive/v3
# OAK_VAULT_CONTAINER=CHANGE_ME
# OAK_VAULT_CLIENT_FILE=secrets/google-oauth-client.json
# OAK_VAULT_CREDENTIAL=secrets/google-drive-token.json

# The Financial Spine (architecture D29): its service root, read-only. Leave unset when no
# Spine runs; production requires https:// unless the Spine is on the loopback interface.
# The credential is optional (the Spine has no authentication today) and never printed.
# OAK_SPINE_URL=http://127.0.0.1:8000
# OAK_SPINE_CREDENTIAL=CHANGE_ME

# Generated-paper intake (architecture D31). Under OAK_AUTH=header only these identities,
# comma-separated, may deliver papers; none listed means no intake. The credential, when set,
# must be presented as a bearer on the intake endpoint and is never printed.
# OAK_INTAKE_IDENTITIES=materiality@oak,sampling@oak,analytical-review@oak
# OAK_INTAKE_CREDENTIAL=CHANGE_ME
# OAK_MAX_PROVENANCE_BYTES=1048576
